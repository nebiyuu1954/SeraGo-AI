# ── Django ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=generate-with-django-core-management-utils-get-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (shared with .NET backend)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=neondb
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=your-db-host.neon.tech
DB_PORT=5432

# ── CORS (allow .NET backend + frontend)
CORS_ALLOWED_ORIGINS=https://localhost:5191,http://localhost:5191,http://localhost:5173

# ── Matching Engine
MATCHING_MODEL_NAME=all-MiniLM-L6-v2

# ── API Key (shared secret — SAME value on .NET backend and Django)
# Used by ApiKeyMiddleware to authenticate webhook calls.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
MATCHING_API_KEY=your-shared-secret-here

# ── AI Service Multi-Provider Routing ──────────────────────────────────
# 1. Classification Service: Gemini (generous free tier: 15 RPM / 1M TPM) -> Groq fallback
CLASSIFICATION_AI_PROVIDER=gemini
CLASSIFICATION_AI_MODEL=gemini-2.0-flash
CLASSIFICATION_FALLBACK_PROVIDER=groq
CLASSIFICATION_FALLBACK_MODEL=llama-3.3-70b-versatile

# 2. Cover Letter Service: Ollama (100% free, unlimited, private local LLM) -> Gemini fallback
COVER_LETTER_AI_PROVIDER=ollama
COVER_LETTER_AI_MODEL=llama3.1:8b
COVER_LETTER_FALLBACK_PROVIDER=gemini
COVER_LETTER_FALLBACK_MODEL=gemini-2.0-flash

# ── Provider Credentials ──────────────────────────────────────────────
# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# Groq Cloud (https://console.groq.com/)
GROQ_API_KEY=your-groq-api-key-here

# Ollama Local (http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# DeepSeek API (Optional - https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
